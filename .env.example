# Copy this file to .env.local and fill in values. NEVER commit .env.local.

# ---- Public site URL ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (local dev) ----
# Populated automatically by `pnpm supabase:start` printing the local
# anon + service-role keys. For hosted production (Phase 9), use the
# values from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google OAuth (read by supabase/config.toml) ----
# Created in Google Cloud Console (see SETUP-PHASE-2.md §4).
# Authorized redirect: http://localhost:54321/auth/v1/callback (dev),
# https://<project>.supabase.co/auth/v1/callback (prod).
# These exact names are required by supabase/config.toml's env() refs —
# don't rename them.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ---- Admin allowlist ----
# Comma-separated emails. Anyone in this list can sign in to /admin.
ADMIN_EMAILS=

# ---- Razorpay (Phase 3) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Shiprocket (Phase 3.3) ----
# Shiprocket auth uses your dashboard email + password to mint a
# 10-day JWT via /external/auth/login. Server-side only — never ship
# either to the client.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Nickname of your pickup address in the Shiprocket dashboard (default "Primary").
SHIPROCKET_PICKUP_LOCATION=
# 6-digit pincode of your pickup point (origin for shipping quotes).
SHIPROCKET_PICKUP_PINCODE=
# Shared token Shiprocket sends as x-api-key on status webhooks (#87).
# Generate with: openssl rand -hex 24
SHIPROCKET_WEBHOOK_TOKEN=

# ---- Cloudflare R2 (Phase 4) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_AUDIO_BUCKET=
R2_PAPERS_BUCKET=

# ---- Resend (Phase 7) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---- Cron (Vercel Cron → /api/cron/*) ----
# Random secret; Vercel sends it as `Authorization: Bearer $CRON_SECRET`.
# Generate with: openssl rand -hex 32
CRON_SECRET=

