# Copy this file to .env.local and fill in values. NEVER commit .env.local.

# ---- Public site URL ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (local dev) ----
# Populated automatically by `pnpm supabase:start` printing the local
# anon + service-role keys. For hosted production (Phase 9), use the
# values from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google OAuth ----
# Created in Google Cloud Console (see SETUP-PHASE-2.md §4).
# Authorized redirect: http://localhost:54321/auth/v1/callback (dev),
# https://<project>.supabase.co/auth/v1/callback (prod).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# These two are read by `supabase start` (via env() substitution in
# supabase/config.toml) to wire the Google provider into local Auth.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ---- Admin allowlist ----
# Comma-separated emails. Anyone in this list can sign in to /admin.
ADMIN_EMAILS=

# ---- Razorpay (Phase 3) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Cloudflare R2 (Phase 4) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_AUDIO_BUCKET=
R2_PAPERS_BUCKET=

# ---- Resend (Phase 7) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=
